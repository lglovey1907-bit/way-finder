# Staff sign-in password (required in production). Locally it defaults to "ndls-demo".
ADMIN_PASSWORD=
# Any long random string; signs the staff cookie.
AUTH_SECRET=

# Supabase (free plan, no card): Project Settings → API.
# SUPABASE_URL = Project URL; SUPABASE_SERVICE_ROLE_KEY = the secret / service_role key (keep private).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alternatives (only used if Supabase isn't set):
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=   (or KV_REST_API_URL / KV_REST_API_TOKEN)
# BLOB_READ_WRITE_TOKEN=

# Optional: Digital Asset Links JSON from PWABuilder, for the Android app.
ANDROID_ASSETLINKS=
